uboot:
  env:
    {%- for k, v in env.items() %}
    {{ k }}: "{{ v }}"
    {%- endfor %}
    {%- if uboot.env is defined and uboot.env %}
    {%- for k, v in uboot.env.items() %}
    {{ k }}: "{{ v }}"
    {%- endfor %}
    {%- endif %}
  actions:
    - use: git
      src: {{ uboot.src }}
      {%- if uboot.branch is defined %}
      branch: {{ uboot.branch }}
      {%- endif %}
    {%- if uboot.prebuild is defined and uboot.prebuild %}
{{ uboot.prebuild | indent(4, first=True) }}
    {%- endif %}
    - use: make
      args: {{ uboot.config | default('defconfig') }}
    - use: make
      {%- if uboot.args is defined %}
      args: {{ uboot.args }}
      {%- endif %}
    {%- if uboot.postbuild is defined and uboot.postbuild %}
{{ uboot.postbuild | indent(4, first=True) }}
    {%- endif %}
  result:
    {%- for r in uboot.result | default(['u-boot.bin']) %}
    - "{{ r }}"
    {%- endfor %}
