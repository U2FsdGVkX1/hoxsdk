opensbi:
  env:
    {%- for k, v in env.items() %}
    {{ k }}: "{{ v }}"
    {%- endfor %}
    {%- if opensbi.env is defined and opensbi.env %}
    {%- for k, v in opensbi.env.items() %}
    {{ k }}: "{{ v }}"
    {%- endfor %}
    {%- endif %}
  actions:
    - use: git
      src: {{ opensbi.src }}
      {%- if opensbi.branch is defined %}
      branch: {{ opensbi.branch }}
      {%- endif %}
    {%- if opensbi.prebuild is defined and opensbi.prebuild %}
{{ opensbi.prebuild | indent(4, first=True) }}
    {%- endif %}
    - use: make
      args: {{ opensbi.args | default('PLATFORM=generic') }}
    {%- if opensbi.postbuild is defined and opensbi.postbuild %}
{{ opensbi.postbuild | indent(4, first=True) }}
    {%- endif %}
  result:
    {%- for r in opensbi.result | default(['build/platform/generic/firmware/fw_dynamic.bin']) %}
    - "{{ r }}"
    {%- endfor %}